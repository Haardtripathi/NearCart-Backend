# Disposable local test-DB env for the vitest/supertest suite (tests/).
#
# HARD RULE: DATABASE_URL here must always be a local `file:` URL. tests/setup.ts throws at
# startup if it isn't — this file (and the whole test suite) must NEVER be pointed at the real
# production Turso `libsql://` database configured in `.env`. See CLAUDE.md at the workspace root
# for why that matters.
#
# `tests/global-setup.ts` runs `prisma db push` against this DB once before the suite and deletes
# the resulting `.db`/-journal/-wal/-shm files afterward — nothing here is meant to persist.
APP_NAME=NearKart Test
NODE_ENV=test
PORT=5099
FRONTEND_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173
DATABASE_URL=file:./tests/test.db

# Dummy — production-strength secret validation in config/env.ts only kicks in when
# NODE_ENV=production, so this is fine for a local test run.
JWT_ACCESS_SECRET=dev-only-test-secret-not-for-production-use-1234567890
JWT_ACCESS_EXPIRES_IN=15m
AUTH_REFRESH_COOKIE_NAME=nearkart_test_refresh
AUTH_REFRESH_TTL_DAYS=1

# Bootstrapped once per test run via `ensureBootstrapAdmin()` (services/bootstrap.service.ts),
# called from tests/helpers/fixtures.ts — gives the test suite an ADMIN account to approve/map
# test shops without needing a real admin seeded any other way.
ADMIN_BOOTSTRAP_EMAIL=admin@test.nearcart.local
ADMIN_BOOTSTRAP_PASSWORD=TestAdminPassword123!
ADMIN_BOOTSTRAP_FULL_NAME=Test Platform Admin

REQUEST_BODY_LIMIT=1mb

# Intentionally blank: inventory-client.service.ts is mocked at the test level (see
# tests/helpers/inventory-mock.ts) rather than hitting a real NearCart-Inventory instance, so
# there's nothing real to point these at for the required test scenarios.
INVENTORY_SERVICE_URL=
INVENTORY_API_BASE_URL=
INVENTORY_INTERNAL_TOKEN=test-internal-token
INVENTORY_REQUEST_TIMEOUT_MS=8000

# Intentionally blank: no Redis needed for tests — kvStore.ts and rateLimit.ts both fall back to
# an in-memory implementation when REDIS_URL is unset, which is exactly what a single-process
# test run wants (no external service dependency, no cross-test-run leakage).
REDIS_URL=

# Intentionally blank: weather.service.ts runs in deterministic stub mode (condition "unknown",
# 0 weather surcharge) when unset — required for the checkout/validate fee-parity assertions to
# be deterministic byte-identical comparisons.
WEATHER_API_KEY=

DEFAULT_SERVICE_RADIUS_KM=10

# Distance-based delivery fee formula under test (utils/geo.ts's computeDeliveryFee):
#   fee = clamp(DELIVERY_FEE_BASE + DELIVERY_FEE_PER_KM * distanceKm, DELIVERY_FEE_MIN, DELIVERY_FEE_MAX)
# Set explicitly (matching config/env.ts's own defaults) rather than left unset, so the test
# suite's expected-value calculations are reading real config instead of coincidentally matching
# a hardcoded fallback.
DELIVERY_FEE_BASE=20
DELIVERY_FEE_PER_KM=8
DELIVERY_FEE_MIN=20
DELIVERY_FEE_MAX=150

TRUST_PROXY_HOPS=0

# Intentionally blank: Cloudinary/Firebase are lazy-initialized and no-op/503 when unconfigured;
# nothing under test touches shop-logo upload or push notifications.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_FOLDER=nearkart-test
IMAGE_UPLOAD_MAX_BYTES=5242880
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
