generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

enum UserRole {
  CUSTOMER
  SHOP_OWNER
  ADMIN
  RIDER
}

enum ShopApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum OrderStatus {
  PENDING_CONFIRMATION
  ACCEPTED
  REJECTED
  PREPARING
  READY_FOR_PICKUP
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum PaymentMethod {
  COD
  ONLINE
  PAY_ON_PICKUP
}

enum ShopMembershipRole {
  OWNER
  MANAGER
  STAFF
}

enum InventorySyncStatus {
  NOT_APPLICABLE
  PENDING
  SYNCED
  FAILED
}

enum CouponDiscountType {
  PERCENTAGE
  FLAT
}

model User {
  id               String            @id @default(cuid())
  fullName         String
  email            String            @unique
  phone            String?           @unique
  passwordHash     String
  role             UserRole
  isActive         Boolean           @default(true)
  isVerified       Boolean           @default(false)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  addresses        Address[]
  customerOrders   Order[]           @relation("CustomerOrders")
  customerProfile  CustomerProfile?
  refreshTokens    RefreshToken[]
  deviceTokens     DeviceToken[]
  shopOwnerProfile ShopOwnerProfile?
  orderReviews     OrderReview[]
  favoriteShops    FavoriteShop[]
  couponRedemptions CouponRedemption[]
}

model CustomerProfile {
  id               String   @id @default(cuid())
  userId           String   @unique
  defaultAddressId String?
  // Round-2 loyalty/rewards feature — earned at a flat rate off `Order.totalAmount` the moment
  // an order reaches DELIVERED (see `services/loyalty.service.ts`'s `awardLoyaltyPointsForOrder`,
  // called from `orders.service.ts`'s two DELIVERED transition points). No redemption flow yet
  // (v1 is earn-only, mirrors how OrderReview shipped rating-only before any moderation flow) —
  // `loyaltyPoints` is the running balance, `loyaltyLedger` is the append-only history of how it
  // got there.
  loyaltyPoints    Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  defaultAddress   Address? @relation("CustomerDefaultAddress", fields: [defaultAddressId], references: [id], onDelete: SetNull)
  loyaltyLedger    LoyaltyLedgerEntry[]

  @@index([defaultAddressId])
}

model ShopOwnerProfile {
  id           String           @id @default(cuid())
  userId       String           @unique
  businessName String
  gstNumber    String?          @unique
  isApproved   Boolean          @default(false)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  memberships  ShopMembership[]
  shops        Shop[]
  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Shop {
  id             String             @id @default(cuid())
  ownerProfileId String
  name           String
  slug           String             @unique
  description    String?
  logoImageUrl   String?
  category       String
  phone          String
  email          String?
  addressLine1   String
  addressLine2   String?
  city           String
  area           String?
  pincode        String
  latitude       Float?
  longitude      Float?
  openingTime    String?
  closingTime    String?
  publicCatalogEnabled Boolean      @default(false)
  inventoryOrganizationId String?
  inventoryBranchId String?
  deliveryEnabled Boolean           @default(true)
  minimumOrderAmount Int            @default(0)
  deliveryFeeDefault Int            @default(0)
  estimatedDeliveryMinutes Int?
  serviceRadiusKm Float?
  lastCatalogSyncAt DateTime?
  // Daily open/closed confirmation — null isOpenToday / null todayStatusUpdatedAt means the
  // shop owner hasn't confirmed today's availability yet ("PENDING_CONFIRMATION"). See
  // `src/utils/shop-availability.ts`'s `getShopTodayStatus` for the tri-state derivation
  // (reuses the UTC-day-boundary convention from `orders.service.ts`'s `createOrderNumber`).
  isOpenToday       Boolean?
  todayStatusReason String?
  todayStatusUpdatedAt DateTime?
  isActive       Boolean            @default(true)
  approvalStatus ShopApprovalStatus @default(PENDING)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  memberships    ShopMembership[]
  orders         Order[]
  reviews        OrderReview[]
  favoritedBy    FavoriteShop[]
  ownerProfile   ShopOwnerProfile   @relation(fields: [ownerProfileId], references: [id], onDelete: Cascade)

  @@index([ownerProfileId])
  @@index([approvalStatus])
  @@index([publicCatalogEnabled])
  @@index([inventoryOrganizationId])
  @@index([inventoryBranchId])
}

model Address {
  id                         String            @id @default(cuid())
  userId                     String
  label                      String
  fullName                   String
  phone                      String
  line1                      String
  line2                      String?
  city                       String
  area                       String?
  pincode                    String
  landmark                   String?
  latitude                   Float?
  longitude                  Float?
  isDefault                  Boolean           @default(false)
  createdAt                  DateTime          @default(now())
  updatedAt                  DateTime          @updatedAt
  customerDefaultForProfiles CustomerProfile[] @relation("CustomerDefaultAddress")
  user                       User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isDefault])
}

model RefreshToken {
  id        String   @id @default(cuid())
  userId     String
  tokenHash  String   @unique
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  revokedAt  DateTime?
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

// Registered by the customer app on login for push notifications (order confirmed/rejected,
// driver assigned, out for delivery, delivered, auto-cancelled). ownerType is fixed to
// 'CUSTOMER' here — this backend only ever notifies customers, mirroring the shape of
// NearCart-Inventory's own DeviceToken table (which also covers shop staff + drivers) so the
// push-notification service code looks the same on both sides.
model DeviceToken {
  id            String   @id @default(cuid())
  ownerType     String   @default("CUSTOMER")
  ownerId       String
  expoPushToken String
  platform      String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  user          User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@unique([ownerId, expoPushToken])
  @@index([ownerId])
}

model Order {
  id                   String        @id @default(cuid())
  orderNumber          String        @unique
  customerUserId       String?
  shopId               String
  shopRecordId         String?
  shopName             String
  status               OrderStatus   @default(PENDING_CONFIRMATION)
  paymentStatus        PaymentStatus @default(PENDING)
  paymentMethod        PaymentMethod
  customerName         String
  customerPhone        String
  customerEmail        String?
  deliveryAddressId    String?
  deliveryAddressLabel String?
  deliveryAddressLine1 String
  deliveryAddressLine2 String?
  city                 String
  area                 String?
  pincode              String
  landmark             String?
  latitude             Float?
  longitude            Float?
  notes                String?
  subtotal             Int
  deliveryFee          Int           @default(0)
  weatherSurchargeFee  Int           @default(0)
  weatherCondition     String?
  platformFee          Int           @default(0)
  // Round-2 promo/coupon feature. `couponCode` is the redeemed code (denormalized onto the
  // order for display — the authoritative link is `couponRedemption`), `discountAmount` is what
  // was actually subtracted from the pre-discount total to reach `totalAmount` (0 when no coupon
  // was applied). Resolved and validated server-side inside `orders.service.ts`'s `createOrder`
  // transaction against the authoritative checkout subtotal — never trusts a client-supplied
  // discount figure, same posture as `getAuthoritativeCheckoutSnapshot`.
  couponCode           String?
  discountAmount       Int           @default(0)
  couponRedemption     CouponRedemption?
  totalAmount          Int
  placedAt             DateTime      @default(now())
  acceptedAt           DateTime?
  deliveredAt          DateTime?
  // Delivery-proof photo captured by the driver on the NearCart-Inventory side (Cloudinary URL)
  // and relayed here via the DELIVERED webhook event / poll-refresh path — see
  // `applyInventoryOrderEvent` and `refreshOrderStatusFromInventory` in `orders.service.ts`.
  // Nullable: orders delivered before this field existed, and any DELIVERED event/poll response
  // that doesn't carry a photo (e.g. the sibling repo hasn't shipped its side yet, or a driver
  // skipped the photo step), simply leave this null rather than erroring.
  deliveryProofPhotoUrl String?
  // Round-2 loyalty/rewards feature. Null until this order reaches DELIVERED and
  // `awardLoyaltyPointsForOrder` runs (see loyalty.service.ts) — null is deliberately distinct
  // from 0 (an order that *was* processed but earned zero points, e.g. a very small basket)
  // so the frontend can tell "not delivered/not processed yet" apart from "processed, earned 0".
  loyaltyPointsEarned  Int?
  loyaltyLedgerEntries LoyaltyLedgerEntry[]
  // Populated from the `assignedDriver` payload on the inbound DRIVER_ASSIGNED webhook event
  // (see internal.controller.ts / orders.service.ts's applyInventoryOrderEvent) — that payload
  // previously was only used for the push-notification body text and discarded. NearCart-
  // Inventory's Driver model has live lastKnownLatitude/lastKnownLongitude, but there is no
  // marketplace-bridge endpoint exposing it to this app yet, so no live driver coordinates are
  // stored here — just the identity/contact fields the webhook already carries. The order
  // tracking screen derives an estimated live position by interpolating between the shop's and
  // the delivery address's coordinates against elapsed time / ETA instead of true GPS.
  driverName           String?
  driverPhone          String?
  driverVehicleType    String?
  driverAssignedAt     DateTime?
  inventorySalesOrderId String?
  inventorySalesOrderNumber String?
  inventorySyncStatus  InventorySyncStatus @default(NOT_APPLICABLE)
  inventorySyncError   String?
  inventoryLastSyncedAt DateTime?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt
  customerUser         User?         @relation("CustomerOrders", fields: [customerUserId], references: [id], onDelete: SetNull)
  items                OrderItem[]
  shop                 Shop?         @relation(fields: [shopRecordId], references: [id], onDelete: SetNull)
  review               OrderReview?

  @@index([createdAt])
  @@index([customerUserId])
  @@index([shopId])
  @@index([shopRecordId])
  @@index([status])
  @@index([inventorySalesOrderId])
}

model OrderItem {
  id             String   @id @default(cuid())
  orderId        String
  storeProductId String
  inventoryProductId String?
  inventoryVariantId String?
  name           String
  brand          String?
  size           String?
  unitLabel      String?
  image          String?
  price          Int
  mrp            Int?
  quantity       Int
  lineTotal      Int
  createdAt      DateTime @default(now())
  order          Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

// A customer's rating/review of one completed order. One-to-one with Order
// (@unique orderId — enforced again at the service layer with a 409 before
// insert, but the DB constraint is the real backstop). `shopId` is
// deliberately the real `Shop.id` FK (not the slug-style denormalized
// `Order.shopId`/nullable `Order.shopRecordId` split) — a review can only be
// created for an order that already has a resolved `shopRecordId` (checkout
// requires a mapped shop), so there's no null case to design around here,
// and keeping it a plain required FK makes the shop-aggregate query
// (`_avg`/`_count` grouped by shopId for the public shop-detail response) a
// direct index lookup instead of a join through Order.
model OrderReview {
  id         String   @id @default(cuid())
  orderId    String   @unique
  customerId String
  shopId     String
  rating     Int
  comment    String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  customer   User     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  shop       Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@index([shopId])
  @@index([customerId])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actorType  String
  action     String
  entityType String
  entityId   String
  beforeJson String?
  afterJson  String?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([action])
  @@index([createdAt])
}

// A customer's saved/favorited shop — simple bookmark, no rating/comment (that's OrderReview's
// job). Checked for existence via grep before adding: no Favorite/Wishlist/Bookmark model
// existed anywhere in this schema.
model FavoriteShop {
  id        String   @id @default(cuid())
  userId    String
  shopId    String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  shop      Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@unique([userId, shopId])
  @@index([userId])
  @@index([shopId])
}

// Round-2 promo/coupon feature. A shop-agnostic, platform-level coupon (v1 — no per-shop
// scoping, matches how there's no shop-owner-facing CRUD UI for these yet either; codes are
// seeded directly, see prisma/seed-coupons.ts). `discountValue` means "percent, 1-100" when
// discountType is PERCENTAGE and "flat rupees off" when FLAT — see
// `services/coupon.service.ts`'s `computeDiscountAmount` for the one place that interprets it.
model Coupon {
  id                String              @id @default(cuid())
  code              String              @unique
  description       String?
  discountType      CouponDiscountType
  discountValue     Int
  minOrderAmount    Int                 @default(0)
  maxDiscountAmount Int?
  usageLimit        Int?
  perUserLimit      Int                 @default(1)
  timesRedeemed     Int                 @default(0)
  validFrom         DateTime?
  validUntil        DateTime?
  isActive          Boolean             @default(true)
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  redemptions       CouponRedemption[]

  @@index([isActive])
}

// One row per order a coupon was actually applied to — `orderId` is unique (a coupon can only
// be redeemed once per order), and `(couponId, userId)` rows are counted (not uniqued) against
// `Coupon.perUserLimit` in `coupon.service.ts`. `discountAmount` is a snapshot of what was
// granted at redemption time, independent of the coupon's current config (which may change/
// expire later without rewriting history).
model CouponRedemption {
  id             String   @id @default(cuid())
  couponId       String
  userId         String
  orderId        String   @unique
  discountAmount Int
  createdAt      DateTime @default(now())
  coupon         Coupon   @relation(fields: [couponId], references: [id], onDelete: Cascade)
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  order          Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([couponId])
  @@index([userId])
}

// Round-2 loyalty/rewards feature — append-only earn history behind `CustomerProfile.loyaltyPoints`.
// `orderId` is nullable+SetNull (not the reverse of a required relation) so a ledger entry
// survives if its order is ever hard-deleted; `points` is always positive in v1 (earn-only, no
// redemption/spend rows yet).
model LoyaltyLedgerEntry {
  id                String          @id @default(cuid())
  customerProfileId String
  orderId           String?
  points            Int
  reason            String
  createdAt         DateTime        @default(now())
  customerProfile   CustomerProfile @relation(fields: [customerProfileId], references: [id], onDelete: Cascade)
  order             Order?          @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([customerProfileId])
}

model ShopMembership {
  id             String             @id @default(cuid())
  shopId          String
  ownerProfileId  String
  role            ShopMembershipRole @default(OWNER)
  createdAt       DateTime           @default(now())
  ownerProfile    ShopOwnerProfile   @relation(fields: [ownerProfileId], references: [id], onDelete: Cascade)
  shop            Shop               @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@unique([shopId, ownerProfileId])
  @@index([ownerProfileId])
}
