APP_NAME=NearKart
NODE_ENV=development
PORT=5002
FRONTEND_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173
INVENTORY_SERVICE_URL=
INVENTORY_API_BASE_URL=
INVENTORY_INTERNAL_TOKEN=
INVENTORY_REQUEST_TIMEOUT_MS=8000
DATABASE_URL="file:./prisma/nearkart.db"
JWT_ACCESS_SECRET="change-me-to-a-long-random-secret"
JWT_ACCESS_EXPIRES_IN=15m
AUTH_REFRESH_COOKIE_NAME=nearkart_refresh
AUTH_REFRESH_TTL_DAYS=30
REQUEST_BODY_LIMIT=1mb
ADMIN_BOOTSTRAP_EMAIL=admin@nearkart.local
ADMIN_BOOTSTRAP_PASSWORD=StrongPassword123
ADMIN_BOOTSTRAP_FULL_NAME="NearKart Platform Admin"
OTP_PROVIDER=
OTP_SENDER_ID=
OTP_API_KEY=
OTP_TTL_SECONDS=600
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_VERIFY_ATTEMPTS=5
REDIS_URL=redis://localhost:6379
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="NearKart <no-reply@nearkart.local>"
SMTP_SECURE=false
GOOGLE_MAPS_API_KEY=
# OpenWeatherMap API key for the live delivery-ETA weather factor. Leave
# unset to run weather.service in stub mode (fixed 1.1x multiplier) —
# shop browsing/checkout never depends on this being configured.
WEATHER_API_KEY=
DEFAULT_SERVICE_RADIUS_KM=10
# Reverse-proxy hops to trust for req.ip / X-Forwarded-For (rate limiting
# depends on this being correct). Leave unset to use the default: 1 in
# production, 0 in development.
TRUST_PROXY_HOPS=
