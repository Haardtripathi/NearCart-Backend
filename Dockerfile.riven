# Build/runtime image for the NearCart backend.
#
# Committed deliberately: the host's auto-generated Dockerfile installed dependencies in one
# stage, ran `prisma generate` in a second, and then copied node_modules from the FIRST stage
# into the runtime image. Prisma's client is code-generated into node_modules/.prisma/client at
# generate time, so the runtime image never contained it and every boot died with
#   Error: Cannot find module '.prisma/client/default'
# Here the same stage that generates the client is the one whose node_modules ships.
#
# Node 22 (not 20): firebase-admin@14 and @prisma/streams-local both declare "node >= 22", and on
# 20 every install logged EBADENGINE.

FROM node:22-alpine AS builder
WORKDIR /app

# Schema + prisma.config.ts must be present before `prisma generate` runs.
COPY package*.json prisma.config.ts ./
COPY prisma ./prisma
RUN npm ci

COPY . .
RUN npx prisma generate && npm run build

FROM node:22-alpine AS runner
WORKDIR /app
ENV NODE_ENV=production

# node_modules comes from the builder, so the generated Prisma client comes with it.
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/dist ./dist
COPY --from=builder /app/prisma ./prisma
COPY --from=builder /app/package*.json ./

EXPOSE 5002
CMD ["node", "dist/server.js"]
